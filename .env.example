# =====================================================================
# APP CONFIGURATION
# =====================================================================
GOREST_APP_NAME=gorest-api-starter-mysql
GOREST_APP_VERSION=1.0.0
GOREST_APP_ENV=development
GOREST_APP_TIMEZONE=Asia/Jakarta
GOREST_APP_DEBUG=false
GOREST_APP_CHECK_FOR_UPDATES=true

# =====================================================================
# LOGGER CONFIGURATION
# =====================================================================
GOREST_LOG_DIR=./logs
GOREST_LOG_FILE=app.log
GOREST_LOG_CALLER=true
GOREST_LOG_MAX_FILE_SIZE=100
GOREST_LOG_MAX_BACKUPS=7
GOREST_LOG_MAX_AGE=7

# =====================================================================
# SERVER CONFIGURATION
# =====================================================================
# Set the production host to 0.0.0.0 when the service must accept external traffic.
GOREST_SERVER_HOST=127.0.0.1
GOREST_SERVER_PORT=3000

## Cors configuration
GOREST_SERVER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GOREST_SERVER_CORS_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
GOREST_SERVER_CORS_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID
GOREST_SERVER_CORS_EXPOSE_HEADERS=
GOREST_SERVER_CORS_MAX_AGE=300
GOREST_SERVER_CORS_ALLOW_CREDENTIALS=
GOREST_SERVER_CORS_ALLOW_PRIVATE_NETWORK=
GOREST_SERVER_CORS_DISABLE_VALUE_REDACTION=

## Recover middleware configuration
GOREST_SERVER_RECOVER_ENABLE_STACK_TRACE=

## Request ID middleware configuration
GOREST_SERVER_REQUEST_ID_HEADER=

## Compression middleware configuration
GOREST_SERVER_COMPRESS_LEVEL=

## Helmet security middleware configuration
GOREST_SERVER_HELMET_XSS_PROTECTION=
GOREST_SERVER_HELMET_CONTENT_TYPE_NOSNIFF=
GOREST_SERVER_HELMET_X_FRAME_OPTIONS=
GOREST_SERVER_HELMET_CONTENT_SECURITY_POLICY=
GOREST_SERVER_HELMET_REFERRER_POLICY=
GOREST_SERVER_HELMET_PERMISSION_POLICY=
GOREST_SERVER_HELMET_CROSS_ORIGIN_EMBEDDER_POLICY=
GOREST_SERVER_HELMET_CROSS_ORIGIN_OPENER_POLICY=
GOREST_SERVER_HELMET_CROSS_ORIGIN_RESOURCE_POLICY=
GOREST_SERVER_HELMET_ORIGIN_AGENT_CLUSTER=
GOREST_SERVER_HELMET_X_DNS_PREFETCH_CONTROL=
GOREST_SERVER_HELMET_X_DOWNLOAD_OPTIONS=
GOREST_SERVER_HELMET_X_PERMITTED_CROSS_DOMAIN=
GOREST_SERVER_HELMET_HSTS_MAX_AGE=
GOREST_SERVER_HELMET_HSTS_EXCLUDE_SUBDOMAINS=
GOREST_SERVER_HELMET_CSP_REPORT_ONLY=
GOREST_SERVER_HELMET_HSTS_PRELOAD_ENABLED=

## Rate Limiter middleware configuration
GOREST_SERVER_RATE_LIMIT_MAX=50
GOREST_SERVER_RATE_LIMIT_EXPIRATION=1m
GOREST_SERVER_RATE_LIMIT_SKIP_FAILED_REQUESTS=
GOREST_SERVER_RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=
GOREST_SERVER_RATE_LIMIT_DISABLE_HEADERS=
GOREST_SERVER_RATE_LIMIT_DISABLE_VALUE_REDACTION=

## Core server configuration
# These Fiber Config fields are applied by app/config/server.go.
GOREST_SERVER_BODY_LIMIT=4194304
GOREST_SERVER_READ_TIMEOUT=10s
GOREST_SERVER_WRITE_TIMEOUT=30s
GOREST_SERVER_IDLE_TIMEOUT=120s
GOREST_SERVER_HEADER=
GOREST_SERVER_STRICT_ROUTING=
GOREST_SERVER_CASE_SENSITIVE=
GOREST_SERVER_SKIP_UNMATCHED_ROUTES=
GOREST_SERVER_DISABLE_HEAD_AUTO_REGISTER=
GOREST_SERVER_DISABLE_FLASH_MESSAGES=
GOREST_SERVER_IMMUTABLE=
GOREST_SERVER_UNESCAPE_PATH=
GOREST_SERVER_MAX_RANGES=
GOREST_SERVER_CONCURRENCY=
GOREST_SERVER_VIEWS_LAYOUT=
GOREST_SERVER_PASS_LOCALS_TO_VIEWS=
GOREST_SERVER_PASS_LOCALS_TO_CONTEXT=
GOREST_SERVER_READ_BUFFER_SIZE=
GOREST_SERVER_WRITE_BUFFER_SIZE=
GOREST_SERVER_PROXY_HEADER=
GOREST_SERVER_GET_ONLY=
GOREST_SERVER_DISABLE_KEEPALIVE=
GOREST_SERVER_DISABLE_DEFAULT_DATE=
GOREST_SERVER_DISABLE_DEFAULT_CONTENT_TYPE=
GOREST_SERVER_DISABLE_HEADER_NORMALIZING=
GOREST_SERVER_SHARED_STATE_PREFIX=
GOREST_SERVER_STREAM_REQUEST_BODY=
GOREST_SERVER_DISABLE_PRE_PARSE_MULTIPART_FORM=
GOREST_SERVER_REDUCE_MEMORY_USAGE=
GOREST_SERVER_TRUST_PROXY=
GOREST_SERVER_ENABLE_IP_VALIDATION=
GOREST_SERVER_ENABLE_SPLITTING_ON_PARSERS=
GOREST_SERVER_REQUEST_METHODS=

## Trust middleware proxy configuration
GOREST_SERVER_TRUST_PROXY_PROXIES=
GOREST_SERVER_TRUST_PROXY_LINK_LOCAL=
GOREST_SERVER_TRUST_PROXY_LOOPBACK=
GOREST_SERVER_TRUST_PROXY_PRIVATE=
GOREST_SERVER_TRUST_PROXY_UNIX_SOCKET=

## Listener options map to GOREST v1.1.20 server.ListenerConfig.
## Empty values use GOREST defaults. Set certificate and key together for TLS.
GOREST_SERVER_LISTENER_NETWORK=
GOREST_SERVER_UNIX_SOCKET_PATH=
GOREST_SERVER_CERT_FILE=
GOREST_SERVER_CERT_KEY_FILE=
GOREST_SERVER_CERT_CLIENT_FILE=
GOREST_SERVER_TLS_MIN_VERSION=
GOREST_SERVER_SHUTDOWN_TIMEOUT=
GOREST_SERVER_UNIX_SOCKET_FILE_MODE=
GOREST_SERVER_PREFORK_RECOVER_INTERVAL=
GOREST_SERVER_PREFORK_SHUTDOWN_GRACE_PERIOD=
GOREST_SERVER_PREFORK_RECOVER_THRESHOLD=
GOREST_SERVER_ENABLE_PREFORK=
GOREST_SERVER_ENABLE_PRINT_ROUTES=


# =====================================================================
# DATABASE CONFIGURATION
# =====================================================================
GOREST_DB_DISABLE=false
GOREST_DB_DRIVER=mysql
GOREST_DB_HOST=localhost
GOREST_DB_PORT=3306
GOREST_DB_NAME=
GOREST_DB_USER=
GOREST_DB_PASSWORD=
GOREST_DB_ALLOW_INSECURE_PRODUCTION=
# TLS verifies the server using system roots unless a private CA is configured.
# For mTLS, configure the CA path and both client certificate/key paths.
GOREST_DB_TLS=disable
GOREST_DB_CA_PATH=
GOREST_DB_CERT_PATH=
GOREST_DB_KEY_PATH=
GOREST_DB_CHARSET=utf8mb4
GOREST_DB_TIMEOUT=5s
GOREST_DB_CONNECTION_MAX_LIFETIME=1h
GOREST_DB_MAX_OPEN_CONNECTIONS=100
GOREST_DB_MAX_IDLE_CONNECTIONS=10
GOREST_DB_QUERY_LOGGING=false
GOREST_DB_DIRECTORY=./app/database
GOREST_DB_MIGRATION=false
GOREST_DB_SEEDER=false
GOREST_DB_MIGRATIONS_DIRECTORY=migrations
GOREST_DB_SEEDERS_DIRECTORY=seeders

# =====================================================================
# REDIS CONFIGURATION
# =====================================================================
# Optional. Integration tests use these settings only when explicitly enabled;
# point them at a non-production test instance.
GOREST_REDIS_DISABLE=true
GOREST_REDIS_DATABASE=
GOREST_REDIS_HOST=
GOREST_REDIS_PORT=
GOREST_REDIS_USER=
GOREST_REDIS_PASSWORD=
GOREST_REDIS_TLS=false
GOREST_REDIS_CERT_PATH=
GOREST_REDIS_KEY_PATH=
GOREST_REDIS_CA_PATH=
GOREST_REDIS_TIMEOUT=
GOREST_REDIS_POOL_TIMEOUT=
GOREST_REDIS_CONN_MAX_LIFETIME=
GOREST_REDIS_CONN_MAX_IDLE_TIME=
GOREST_REDIS_ALLOW_INSECURE_PRODUCTION=
GOREST_REDIS_MAX_RETRIES=
GOREST_REDIS_POOL_SIZE=
GOREST_REDIS_MIN_IDLE_CONNS=
GOREST_REDIS_MAX_ACTIVE_CONNS=
GOREST_REDIS_READ_BUFFER_SIZE=
GOREST_REDIS_WRITE_BUFFER_SIZE=

# Optional Redis mTLS integration test. Use a separate Redis endpoint configured
# to require client certificates; the CA file verifies the Redis server.
GOREST_TEST_REDIS_MTLS_HOST=
GOREST_TEST_REDIS_MTLS_PORT=
GOREST_TEST_REDIS_MTLS_DATABASE=
GOREST_TEST_REDIS_MTLS_USER=
GOREST_TEST_REDIS_MTLS_PASSWORD=
GOREST_TEST_REDIS_MTLS_CA_FILE=
GOREST_TEST_REDIS_MTLS_CLIENT_CERT_FILE=
GOREST_TEST_REDIS_MTLS_CLIENT_KEY_FILE=

# =====================================================================
# FILTER (JWT) CONFIGURATION
# =====================================================================
GOREST_FILTER_SIGNATURE_KEY=
GOREST_FILTER_SIGNING_METHOD=
GOREST_FILTER_ACCESS_TOKEN_DURATION=
GOREST_FILTER_REFRESH_TOKEN_DURATION=
GOREST_FILTER_COOKIE_SAME_SITE=
GOREST_FILTER_COOKIE_DOMAIN=
GOREST_FILTER_COOKIE_PATH=
GOREST_FILTER_COOKIE_MAX_AGE=
GOREST_FILTER_COOKIE_SECURE=
GOREST_FILTER_COOKIE_HTTP_ONLY=
GOREST_FILTER_COOKIE_SESSION_ONLY=

# =====================================================================
# MONITORING CONFIGURATION
# =====================================================================
GOREST_MONITORING_DISABLE=
GOREST_MONITORING_ALLOWED_IPS=
GOREST_MONITORING_ENABLE_HTTP_METRICS=

# =====================================================================
# MYSQL INTEGRATION TEST CONFIGURATION
# =====================================================================
# Use only a dedicated, non-production test database. Blank connection
# fields fall back to GOREST_DB_* above; prefer setting them explicitly.
GOREST_TEST_MYSQL_HOST=
GOREST_TEST_MYSQL_PORT=3306
GOREST_TEST_MYSQL_DATABASE=
GOREST_TEST_MYSQL_USER=
GOREST_TEST_MYSQL_PASSWORD=
# Accepted values: disable or true. Optional CA/client certificate paths
# support private CAs and mTLS when the test endpoint requires a client cert.
GOREST_TEST_MYSQL_TLS=disable
GOREST_TEST_MYSQL_CA_FILE=
GOREST_TEST_MYSQL_CERT_FILE=
GOREST_TEST_MYSQL_KEY_FILE=
# Required: repeat the exact test database name before tests can write data.
GOREST_TEST_MYSQL_CONFIRM_DATABASE=
# Only for an explicitly approved non-production database not ending in _test/_testing.
GOREST_TEST_MYSQL_ALLOW_NON_TEST_DATABASE=

# Optional mTLS verification test. Configure these fields for a dedicated
# endpoint/account requiring REQUIRE X509, or leave them blank to reuse the
# GOREST_DB_* settings above in development/testing.
GOREST_TEST_MYSQL_MTLS_HOST=
GOREST_TEST_MYSQL_MTLS_PORT=
GOREST_TEST_MYSQL_MTLS_DATABASE=
GOREST_TEST_MYSQL_MTLS_USER=
GOREST_TEST_MYSQL_MTLS_PASSWORD=
GOREST_TEST_MYSQL_MTLS_TLS=true
GOREST_TEST_MYSQL_MTLS_CA_FILE=
GOREST_TEST_MYSQL_MTLS_CLIENT_CERT_FILE=
GOREST_TEST_MYSQL_MTLS_CLIENT_KEY_FILE=